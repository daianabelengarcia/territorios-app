{
  "expo": {
    "name": "Territorios",
    "slug": "territorios",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Territorios"
    },
    "experiments": {
      "baseUrl": "/territorios-app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.territorios.app"
    },
    "android": {
      "package": "com.territorios.app"
    }
  }
}